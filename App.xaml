<Application x:Class="EZMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Recorder paper: pale ground, ink traces, heat is the only colour -->
        <SolidColorBrush x:Key="Paper" Color="#E4E8EA" />
        <SolidColorBrush x:Key="Strip" Color="#D8DEE2" />
        <SolidColorBrush x:Key="StripHover" Color="#CCD3D8" />
        <SolidColorBrush x:Key="Ink" Color="#14202B" />
        <SolidColorBrush x:Key="InkSoft" Color="#4E5D6B" />
        <FontFamily x:Key="Face">Bahnschrift</FontFamily>

        <!-- Segoe Fluent Icons ships with Windows 11; MDL2 is the Windows 10 fallback -->
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontStretch" Value="SemiCondensed" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>

        <!-- Flat square text button; filled ink when chosen -->
        <Style x:Key="Chip" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource StripHover}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Ink}" />
                                <Setter Property="Foreground" Value="{StaticResource Paper}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#2F7FA8" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource Chip}" />
        <Style TargetType="ToggleButton" BasedOn="{StaticResource Chip}" />
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <!-- Name above, value below; used for drives, fans, temperatures -->
        <DataTemplate x:Key="ReadingTemplate">
            <StackPanel Margin="0,0,32,8">
                <TextBlock Text="{Binding Value}" FontSize="18" FontStretch="SemiCondensed" Foreground="{Binding Brush}" />
                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource InkSoft}" />
            </StackPanel>
        </DataTemplate>
    </Application.Resources>
</Application>
